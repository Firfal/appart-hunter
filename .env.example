# ============================================================
# Copier en .env.local et remplir (jamais committer .env.local)
# ============================================================

# --- Firebase client (exposé au navigateur — ce ne sont PAS des secrets) ---
# Console Firebase → Paramètres du projet → Vos applications → Config SDK
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (SERVEUR uniquement — SECRET, ne jamais exposer) ---
# Console Firebase → Paramètres → Comptes de service → Générer une clé privée (JSON)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- APIs externes (Phases suivantes) ---
PRIM_API_KEY=
RESEND_API_KEY=
